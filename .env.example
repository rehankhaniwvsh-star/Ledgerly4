# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ADMIN_PIN: Master security PIN for CMS owner access
ADMIN_PIN="1234"

# -------------------------------------------------------------
# CONFIGURABLE RATE LIMITING THRESHOLDS
# -------------------------------------------------------------

# 1. Moderate limits on Public Endpoints (e.g., sitemap, robots, health, AI copy generation)
RATE_LIMIT_PUBLIC_WINDOW_MS=60000
RATE_LIMIT_PUBLIC_MAX=100

# 2. Looser limits on Authenticated User actions (e.g., CMS saving, invoice sync, user profile)
RATE_LIMIT_AUTH_USER_WINDOW_MS=60000
RATE_LIMIT_AUTH_USER_MAX=300

# 3. Stricter limits on Authentication routes (login, signup, password reset, admin PIN)
# Combination of per-IP and per-account limits with exponential backoff rather than a hard lockout
RATE_LIMIT_AUTH_IP_WINDOW_MS=900000
RATE_LIMIT_AUTH_IP_MAX=20
RATE_LIMIT_AUTH_ACCOUNT_MAX_ATTEMPTS=5
RATE_LIMIT_AUTH_BASE_BACKOFF_MS=1000
RATE_LIMIT_AUTH_MAX_BACKOFF_MS=300000
RATE_LIMIT_AUTH_BACKOFF_FACTOR=2
RATE_LIMIT_AUTH_DECAY_MS=1800000
